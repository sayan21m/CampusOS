# Database (host-run backend). Docker Compose overrides this to host `postgres`.
DATABASE_URL=postgresql://campusos:campusos_dev@localhost:5432/campus_os

# Hosted Neon: put the DIRECT (non-pooled) connection string in gitignored `.env.neon`.
# Include sslmode=require. Do not replace this local DATABASE_URL.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
# Then: npm run db:target:neon && npm run prisma:status:neon

# Auth
JWT_SECRET=replace_with_a_long_random_secret

# Server
PORT=3000
NODE_ENV=development
# Comma-separated browser origins. Production: https://campus-os-gilt.vercel.app
FRONTEND_URL=http://localhost:5173

# Optional email (Resend). Leave empty to skip outbound mail.
# RESEND_API_KEY=
# MAIL_FROM=CampusOS <noreply@example.com>

# Optional override for e2e scripts (defaults to http://localhost:3000/api/v1)
# E2E_BASE_URL=http://localhost:3000/api/v1
