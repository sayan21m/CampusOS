# Public API origin for the Vite client. Include /api/v1, no trailing slash.
# Local:
# VITE_API_URL=http://localhost:3000/api/v1
# Production (Vercel env, include /api/v1; a missing prefix is appended at runtime):
# VITE_API_URL=https://campusos-rsen.onrender.com/api/v1
VITE_API_URL=http://localhost:3000/api/v1
