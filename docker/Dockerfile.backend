FROM node:22-bookworm-slim AS deps

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production \
    PORT=3000 \
    DATABASE_URL=postgresql://campusos:campusos_dev@postgres:5432/campus_os

COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json prisma.config.ts ./
COPY prisma ./prisma
COPY apps/backend/src ./apps/backend/src
COPY docker/backend-entrypoint.sh ./docker/backend-entrypoint.sh

RUN chmod +x ./docker/backend-entrypoint.sh \
  && npx prisma generate \
  && mkdir -p apps/backend/storage

EXPOSE 3000

ENTRYPOINT ["./docker/backend-entrypoint.sh"]
