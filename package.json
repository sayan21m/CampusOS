{
  "name": "campus_os",
  "version": "1.0.0",
  "description": "CampusOS reimagines college management by bringing academics, collaboration, and campus services together in one intuitive platform built for modern educational institutions.",
  "keywords": [
    "campus-management"
  ],
  "homepage": "https://github.com/sayan21m/CampusOS#readme",
  "bugs": {
    "url": "https://github.com/sayan21m/CampusOS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayan21m/CampusOS.git"
  },
  "license": "ISC",
  "author": "Spark Squad",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node apps/backend/src/index.js",
    "dev": "nodemon apps/backend/src/index.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:watch:coverage": "jest --watch --coverage",
    "test:watch:watchAll": "jest --watch --watchAll",
    "test:watch:watchAll:coverage": "jest --watch --watchAll --coverage"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prettier": "3.9.6"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  }
}
