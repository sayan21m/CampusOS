generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id             Int       @id @default(autoincrement())
  name                String
  email               String    @unique
  passwordHash        String
  role                String
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLogin           DateTime?
  photo_url           String?
  createdAt           DateTime  @default(now())

  passwordResetTokens       passwordResetToken[]
  notices                   Notice[]
  calendarEntries           AcademicCalendar[]
  notifications             Notification[]
  searchHistory             SearchHistory[]
  noticeReads               NoticeRead[]
  notificationPreferences   NotificationPreference[]
  activityLogs              ActivityLog[]

  student Student?
  faculty Faculty?
}

model passwordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@index([userId])
}

model Department {
  dept_id        Int    @id @default(autoincrement())
  dept_name      String @unique
  dept_code      String @unique
  hod_faculty_id Int?   @unique

  hod            Faculty?        @relation("DepartmentHOD", fields: [hod_faculty_id], references: [faculty_id])
  students       Student[]
  faculty        Faculty[]       @relation("DepartmentFaculty")
  subjects       Subject[]
  timetableSlots TimetableSlot[]
}

model Student {
  student_id     Int     @id @default(autoincrement())
  user_id        Int     @unique
  roll_number    String  @unique
  full_name      String
  dept_id        Int
  semester       Int
  section        String
  admission_year Int
  phone          String?
  photo_url      String?

  user        User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  department  Department   @relation(fields: [dept_id], references: [dept_id])
  submissions Submission[]
  attendance  Attendance[]

  @@index([dept_id])
}

model Faculty {
  faculty_id  Int     @id @default(autoincrement())
  user_id     Int     @unique
  employee_id String  @unique
  full_name   String
  dept_id     Int
  designation String
  phone       String?
  photo_url   String?

  user                  User                       @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  department            Department                 @relation("DepartmentFaculty", fields: [dept_id], references: [dept_id])
  hodOfDepartment       Department?                @relation("DepartmentHOD")
  assignments           Assignment[]
  regularTimetableSlots TimetableSlot[]            @relation("RegularTimetableFaculty")
  timetableExceptions   TimetableException[]       @relation("ExceptionReplacementFaculty")
  notes                 Notes[]
  subjectAllocations    FacultySubjectAllocation[]
  attendance            Attendance[]

  @@index([dept_id])
}

model Subject {
  subject_id   Int     @id @default(autoincrement())
  subject_code String  @unique
  subject_name String
  dept_id      Int
  semester     Int
  credits      Int
  is_active    Boolean @default(true)

  department         Department                 @relation(fields: [dept_id], references: [dept_id])
  assignments        Assignment[]
  timetableSlots     TimetableSlot[]
  notes              Notes[]
  facultyAllocations FacultySubjectAllocation[]
  attendance         Attendance[]

  @@index([dept_id])
}

model FacultySubjectAllocation {
  allocation_id Int      @id @default(autoincrement())
  faculty_id    Int
  subject_id    Int
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  faculty Faculty @relation(fields: [faculty_id], references: [faculty_id], onDelete: Cascade)
  subject Subject @relation(fields: [subject_id], references: [subject_id], onDelete: Cascade)

  @@unique([faculty_id, subject_id])
  @@index([subject_id])
  @@index([faculty_id])
}

model Assignment {
  assignment_id  Int      @id @default(autoincrement())
  subject_id     Int
  faculty_id     Int
  title          String
  description    String
  section        String
  deadline       DateTime
  max_marks      Int
  allow_late     Boolean  @default(false)
  attachment_url String?
  created_at     DateTime @default(now())

  subject     Subject      @relation(fields: [subject_id], references: [subject_id])
  faculty     Faculty      @relation(fields: [faculty_id], references: [faculty_id])
  submissions Submission[]

  @@index([subject_id])
  @@index([faculty_id])
  @@index([deadline])
}

model Submission {
  submission_id Int       @id @default(autoincrement())
  assignment_id Int
  student_id    Int
  file_url      String
  submitted_at  DateTime  @default(now())
  is_late       Boolean   @default(false)
  marks         Int?
  feedback      String?
  graded_at     DateTime?
  status        String    @default("Unchecked")

  assignment Assignment @relation(fields: [assignment_id], references: [assignment_id], onDelete: Cascade)
  student    Student    @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@unique([assignment_id, student_id])
  @@index([assignment_id])
  @@index([student_id])
}

model Notice {
  notice_id      Int      @id @default(autoincrement())
  created_by     Int
  title          String
  content        String
  category       String
  priority       String
  target_type    String
  target_value   String
  attachment_url String?
  created_at     DateTime @default(now())

  user  User         @relation(fields: [created_by], references: [user_id], onDelete: Cascade)
  reads NoticeRead[]

  @@index([created_by])
  @@index([target_type, target_value])
  @@index([created_at])
}

model NoticeRead {
  notice_read_id Int      @id @default(autoincrement())
  notice_id      Int
  user_id        Int
  read_at        DateTime @default(now())

  notice Notice @relation(fields: [notice_id], references: [notice_id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([notice_id, user_id])
  @@index([user_id])
  @@index([notice_id])
}

model NotificationPreference {
  preference_id Int      @id @default(autoincrement())
  user_id       Int
  category      String
  email_enabled Boolean  @default(true)
  updated_at    DateTime @updatedAt

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, category])
  @@index([user_id])
}

model ActivityLog {
  activity_id Int      @id @default(autoincrement())
  user_id     Int
  action      String
  detail      String?
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id, created_at])
}

enum TimetableExceptionType {
  ROOM_TIME_CHANGE
  FACULTY_SUBSTITUTION
  CANCELLED
  RESCHEDULED
}

model TimetableSlot {
  timetable_id Int      @id @default(autoincrement())
  subject_id   Int
  faculty_id   Int
  dept_id      Int
  semester     Int
  section      String
  day_of_week  Int
  period       Int
  room         String
  start_time   String
  end_time     String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  subject    Subject    @relation(fields: [subject_id], references: [subject_id])
  faculty    Faculty    @relation("RegularTimetableFaculty", fields: [faculty_id], references: [faculty_id])
  department Department @relation(fields: [dept_id], references: [dept_id])

  exceptions TimetableException[]
  attendance Attendance[]

  @@unique([dept_id, semester, section, day_of_week, period])
  @@index([faculty_id, day_of_week])
  @@index([dept_id, semester, section])
}

model TimetableException {
  timetable_exception_id Int                    @id @default(autoincrement())
  timetable_id           Int
  exception_type         TimetableExceptionType

  original_date    DateTime  @db.Date
  rescheduled_date DateTime? @db.Date

  replacement_faculty_id Int?
  period                 Int?
  room                   String?
  start_time             String?
  end_time               String?

  reason     String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  timetable           TimetableSlot @relation(fields: [timetable_id], references: [timetable_id], onDelete: Cascade)
  replacement_faculty Faculty?      @relation("ExceptionReplacementFaculty", fields: [replacement_faculty_id], references: [faculty_id])

  @@unique([timetable_id, original_date])
  @@index([original_date])
  @@index([rescheduled_date])
  @@index([replacement_faculty_id, rescheduled_date])
}

enum MaterialType {
  LECTURE_NOTES
  PRESENTATIONS
  LAB_MANUALS
  REFERENCE_MATERIAL
  PREVIOUS_YEAR_PAPERS
}

enum CalendarEntryType {
  HOLIDAY
  EXAMINATION
  ASSIGNMENT_DEADLINE
  EVENT
  LAST_WORKING_DAY
}

model AcademicCalendar {
  calendar_id   Int               @id @default(autoincrement())
  title         String
  description   String?
  entry_type    CalendarEntryType
  start_date    DateTime          @db.Date
  end_date      DateTime          @db.Date
  academic_year Int
  created_by    Int?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt

  creator User? @relation(fields: [created_by], references: [user_id], onDelete: SetNull)

  @@index([academic_year])
  @@index([entry_type])
  @@index([start_date, end_date])
  @@index([created_by])
}

model Notes {
  notes_id    Int @id @default(autoincrement())
  subject_id  Int
  uploaded_by Int

  title           String
  description     String?
  unit_number     Int
  material_type   MaterialType
  storage_key     String
  file_size_bytes BigInt
  academic_year   Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  subject Subject @relation(fields: [subject_id], references: [subject_id], onDelete: Cascade)
  faculty Faculty @relation(fields: [uploaded_by], references: [faculty_id], onDelete: Cascade)

  @@index([subject_id, unit_number])
  @@index([uploaded_by])
  @@index([academic_year])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model Attendance {
  attendance_id Int              @id @default(autoincrement())
  student_id    Int
  subject_id    Int
  faculty_id    Int
  timetable_id  Int
  class_date    DateTime         @db.Date
  status        AttendanceStatus
  marked_at     DateTime         @default(now())
  updated_at    DateTime         @updatedAt

  student   Student       @relation(fields: [student_id], references: [student_id], onDelete: Cascade)
  subject   Subject       @relation(fields: [subject_id], references: [subject_id], onDelete: Cascade)
  faculty   Faculty       @relation(fields: [faculty_id], references: [faculty_id], onDelete: Cascade)
  timetable TimetableSlot @relation(fields: [timetable_id], references: [timetable_id], onDelete: Cascade)

  @@unique([student_id, timetable_id, class_date])
  @@index([subject_id, class_date])
  @@index([faculty_id, class_date])
  @@index([student_id, subject_id])
}

enum NotificationType {
  ASSIGNMENT_PUBLISHED
  ASSIGNMENT_DEADLINE_48H
  ASSIGNMENT_DEADLINE_12H
  ASSIGNMENT_GRADED
  NOTICE_PUBLISHED
  NOTES_UPLOADED
  ATTENDANCE_SHORTAGE
}

model Notification {
  notification_id Int              @id @default(autoincrement())
  user_id         Int
  title           String
  message         String
  type            NotificationType
  is_read         Boolean          @default(false)
  reference_id    Int?
  email_sent      Boolean          @default(false)
  created_at      DateTime         @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, type, reference_id])
  @@index([user_id, is_read])
  @@index([user_id, created_at])
  @@index([type, reference_id])
}

model SearchHistory {
  search_id  Int      @id @default(autoincrement())
  user_id    Int
  query      String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id, created_at])
}
